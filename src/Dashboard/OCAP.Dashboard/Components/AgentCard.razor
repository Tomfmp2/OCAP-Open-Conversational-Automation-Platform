@using OCAP.Dashboard.Models

<div class="card border-0 shadow-sm bg-dark text-white rounded-3 p-3 mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5 class="fw-bold mb-1 text-primary">@Agent?.Name</h5>
            <p class="text-muted small mb-2">@Agent?.Description</p>
        </div>
        <span class="badge bg-success">@Agent?.Status</span>
    </div>
    <div class="mt-2">
        <small class="text-muted d-block mb-1">Herramientas Habilitadas:</small>
        @if (Agent?.EnabledTools != null)
        {
            @foreach (var tool in Agent.EnabledTools)
            {
                <span class="badge bg-secondary me-1">@tool</span>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public AgentModel? Agent { get; set; }
}
