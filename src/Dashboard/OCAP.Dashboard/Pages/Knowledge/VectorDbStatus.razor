@page "/vector-db"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Base de Datos Vectorial — OCAP</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1"><i class="bi bi-database text-warning me-2"></i>Estado de Base de Datos Vectorial</h1>
            <p class="text-muted mb-0">Arquitectura desacoplada: PostgreSQL pgvector, Qdrant, ChromaDB y Pinecone.</p>
        </div>
        <button class="btn btn-outline-warning" @onclick="TriggerReindex"><i class="bi bi-arrow-repeat me-1"></i> Reindexar Todo</button>
    </div>

    @if (!string.IsNullOrEmpty(_reindexMessage))
    {
        <div class="alert alert-info alert-dismissible fade show mb-4">
            @_reindexMessage
            <button type="button" class="btn-close" @onclick="() => _reindexMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">PostgreSQL pgvector</h6>
                    <span class="badge bg-success">Activo (Default)</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Motor de base de datos relacional con extensión vectorial `pgvector` nativa HNSW / IVFFlat.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Vectores Almacenados:</strong> 4,192</li>
                        <li><strong>Índice:</strong> HNSW (m=16, ef=64)</li>
                        <li><strong>Aislamiento:</strong> Strict TenantId Filter</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">Qdrant Vector DB</h6>
                    <span class="badge bg-secondary">Disponible</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Motor vectorial dedicado ultra-rápido basado en Rust con soporte gRPC.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Endpoint:</strong> http://localhost:6333</li>
                        <li><strong>Colección:</strong> ocap_knowledge_chunks</li>
                        <li><strong>Distance:</strong> Cosine</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">ChromaDB</h6>
                    <span class="badge bg-secondary">Disponible</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Base de datos vectorial embeddable orientada a prototipado y analítica RAG.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Endpoint:</strong> http://localhost:8000</li>
                        <li><strong>Metadata Filter:</strong> Fully Supported</li>
                        <li><strong>Status:</strong> Ready</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">Pinecone Cloud</h6>
                    <span class="badge bg-secondary">Enterprise Cloud</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Servicio de base de datos vectorial serverless en la nube de alta disponibilidad.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Environment:</strong> us-east-1-gcp</li>
                        <li><strong>Metric:</strong> Cosine</li>
                        <li><strong>Status:</strong> Configurable</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _reindexMessage;

    private async Task TriggerReindex()
    {
        _reindexMessage = "Reindexación iniciada en segundo plano para la base de datos vectorial activa.";
        await Task.Delay(500);
    }
}
