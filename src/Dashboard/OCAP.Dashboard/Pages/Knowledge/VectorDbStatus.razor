@page "/vector-db"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Base de Datos Vectorial — OCAP</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-white mb-1"><i class="bi bi-database text-warning me-2"></i>Estado de Base de Datos Vectorial</h1>
            <p class="text-muted mb-0">Arquitectura desacoplada: PostgreSQL pgvector, Qdrant, ChromaDB y Pinecone.</p>
        </div>
        <button class="btn btn-outline-warning" @onclick="TriggerReindex" disabled="@_isReindexing">
            @if (_isReindexing)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                <span>Reindexando...</span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-1"></i>
                <span>Reindexar Todo</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_reindexMessage))
    {
        <div class="alert alert-@(_reindexSuccess ? "success" : "danger") alert-dismissible fade show mb-4">
            <i class="bi bi-@(_reindexSuccess ? "check-circle" : "exclamation-triangle") me-2"></i>
            @_reindexMessage
            <button type="button" class="btn-close" @onclick="() => _reindexMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-warning alert-dismissible mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>@_loadError — mostrando información de arquitectura.
            <button type="button" class="btn-close" @onclick="() => _loadError = null"></button>
        </div>
    }

    <!-- Estadísticas de vectores desde backend -->
    @if (_kbStats != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card bg-dark border-success text-white p-3">
                    <span class="text-secondary small">Total Vectores Indexados</span>
                    <h3 class="fw-bold text-success mt-1">@_kbStats.TotalVectors.ToString("N0")</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark border-info text-white p-3">
                    <span class="text-secondary small">Bases de Conocimiento</span>
                    <h3 class="fw-bold text-info mt-1">@_kbStats.TotalKnowledgeBases</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark border-warning text-white p-3">
                    <span class="text-secondary small">Documentos Procesados</span>
                    <h3 class="fw-bold text-warning mt-1">@_kbStats.TotalDocuments</h3>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">PostgreSQL pgvector</h6>
                    <span class="badge bg-success">Activo (Default)</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Motor de base de datos relacional con extensión vectorial `pgvector` nativa HNSW / IVFFlat.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Vectores Almacenados:</strong> @(_kbStats?.TotalVectors.ToString("N0") ?? "Cargando...")</li>
                        <li><strong>Índice:</strong> HNSW (m=16, ef=64)</li>
                        <li><strong>Aislamiento:</strong> Strict TenantId Filter</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">Qdrant Vector DB</h6>
                    <span class="badge bg-secondary">Disponible</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Motor vectorial dedicado ultra-rápido basado en Rust con soporte gRPC.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Endpoint:</strong> http://localhost:6333</li>
                        <li><strong>Colección:</strong> ocap_knowledge_chunks</li>
                        <li><strong>Distance:</strong> Cosine</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">ChromaDB</h6>
                    <span class="badge bg-secondary">Disponible</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Base de datos vectorial embeddable orientada a prototipado y analítica RAG.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Endpoint:</strong> http://localhost:8000</li>
                        <li><strong>Metadata Filter:</strong> Fully Supported</li>
                        <li><strong>Status:</strong> Ready</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card bg-dark text-white border-secondary h-100">
                <div class="card-header bg-black d-flex justify-content-between">
                    <h6 class="card-title mb-0">Pinecone Cloud</h6>
                    <span class="badge bg-secondary">Enterprise Cloud</span>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-2">Servicio de base de datos vectorial serverless en la nube de alta disponibilidad.</p>
                    <ul class="list-unstyled mb-0 small">
                        <li><strong>Environment:</strong> us-east-1-gcp</li>
                        <li><strong>Metric:</strong> Cosine</li>
                        <li><strong>Status:</strong> Configurable</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _reindexMessage;
    private bool _reindexSuccess = false;
    private bool _isReindexing = false;
    private string? _loadError;
    private KbStatsDto? _kbStats;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            var kbs = await Http.GetFromJsonAsync<List<KnowledgeBaseDto>>("api/knowledge");
            if (kbs != null)
            {
                _kbStats = new KbStatsDto
                {
                    TotalKnowledgeBases = kbs.Count,
                    TotalDocuments = kbs.Sum(k => k.DocumentCount),
                    TotalVectors = kbs.Sum(k => k.VectorCount)
                };
            }
        }
        catch (Exception ex)
        {
            _loadError = $"No se pudieron cargar estadísticas: {ex.Message}";
        }
    }

    private async Task TriggerReindex()
    {
        _isReindexing = true;
        _reindexMessage = null;

        try
        {
            // Obtener todas las knowledge bases del tenant para reindexarlas
            var kbs = await Http.GetFromJsonAsync<List<KnowledgeBaseDto>>("api/knowledge");
            if (kbs == null || !kbs.Any())
            {
                _reindexSuccess = false;
                _reindexMessage = "No hay bases de conocimiento para reindexar. Cree una base de conocimiento primero.";
                return;
            }

            // Reindexar cada base de conocimiento activa
            var errors = new List<string>();
            foreach (var kb in kbs)
            {
                var response = await Http.PostAsJsonAsync("api/knowledge/reindex", new { KnowledgeBaseId = kb.Id });
                if (!response.IsSuccessStatusCode)
                {
                    errors.Add(kb.Name);
                }
            }

            if (errors.Any())
            {
                _reindexSuccess = false;
                _reindexMessage = $"Reindexación completada con errores en: {string.Join(", ", errors)}.";
            }
            else
            {
                _reindexSuccess = true;
                _reindexMessage = $"Reindexación completada exitosamente para {kbs.Count} base(s) de conocimiento.";
                await LoadStats(); // Refrescar estadísticas
            }
        }
        catch (Exception ex)
        {
            _reindexSuccess = false;
            _reindexMessage = $"Error durante la reindexación: {ex.Message}";
        }
        finally
        {
            _isReindexing = false;
        }
    }

    public class KbStatsDto
    {
        public int  TotalKnowledgeBases { get; set; }
        public int  TotalDocuments      { get; set; }
        public long TotalVectors        { get; set; }
    }

    public class KnowledgeBaseDto
    {
        public Guid   Id            { get; set; }
        public string Name          { get; set; } = string.Empty;
        public int    DocumentCount { get; set; }
        public long   VectorCount   { get; set; }
    }
}
