@page "/providers"

<PageTitle>Proveedores de IA & Orquestación — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Proveedores de IA & Orquestación Inteligente</h1>
            <p class="text-secondary mb-0">Gestión dinámica de LLMs, Failover automático, Streaming SSE y Políticas de Costo/Latencia.</p>
        </div>
        <span class="badge bg-success fs-6 p-2">Orquestador: ACTIVO</span>
    </div>

    <!-- Tarjetas de Proveedores -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0 text-primary">OpenAI</h5>
                    @if (activeProvider == "OpenAI")
                    {
                        <span class="badge bg-primary">ACTIVO</span>
                    }
                </div>
                <p class="text-secondary small mb-2">GPT-4o, GPT-4o-mini, GPT-3.5</p>
                <div class="small mb-3">
                    <span class="text-success">● Salud: Operativo</span><br />
                    <span class="text-secondary">Latencia: 12.0 ms</span>
                </div>
                <button class="btn btn-outline-primary btn-sm mt-auto" @onclick='() => SelectProvider("OpenAI")'>
                    Seleccionar Proveedor
                </button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0 text-info">Google Gemini</h5>
                    @if (activeProvider == "Gemini")
                    {
                        <span class="badge bg-info">ACTIVO</span>
                    }
                </div>
                <p class="text-secondary small mb-2">Gemini 1.5 Pro, Flash</p>
                <div class="small mb-3">
                    <span class="text-success">● Salud: Operativo</span><br />
                    <span class="text-secondary">Latencia: 14.0 ms</span>
                </div>
                <button class="btn btn-outline-info btn-sm mt-auto" @onclick='() => SelectProvider("Gemini")'>
                    Seleccionar Proveedor
                </button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0 text-warning">Ollama</h5>
                    @if (activeProvider == "Ollama")
                    {
                        <span class="badge bg-warning text-dark">ACTIVO</span>
                    }
                </div>
                <p class="text-secondary small mb-2">Llama3, Mistral (Self-Hosted)</p>
                <div class="small mb-3">
                    <span class="text-success">● Salud: Local / Docker</span><br />
                    <span class="text-secondary">Latencia: 18.0 ms</span>
                </div>
                <button class="btn btn-outline-warning btn-sm mt-auto" @onclick='() => SelectProvider("Ollama")'>
                    Seleccionar Proveedor
                </button>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0 text-secondary">MockAI</h5>
                    @if (activeProvider == "MockAI")
                    {
                        <span class="badge bg-secondary">ACTIVO</span>
                    }
                </div>
                <p class="text-secondary small mb-2">Simulación de Pruebas Offline</p>
                <div class="small mb-3">
                    <span class="text-success">● Salud: Siempre Válido</span><br />
                    <span class="text-secondary">Latencia: 5.0 ms</span>
                </div>
                <button class="btn btn-outline-secondary btn-sm mt-auto" @onclick='() => SelectProvider("MockAI")'>
                    Seleccionar Proveedor
                </button>
            </div>
        </div>
    </div>

    <!-- Configuración de Parámetros & Prueba -->
    <div class="row g-3">
        <div class="col-md-5">
            <div class="card bg-dark border-secondary p-4 text-white">
                <h5 class="fw-bold mb-3">Configuración del Modelo</h5>

                <div class="mb-3">
                    <label class="form-label text-secondary">Modelo Activo</label>
                    <select class="form-select bg-black text-white border-secondary" @bind="selectedModel">
                        <option value="gpt-4o">gpt-4o (OpenAI)</option>
                        <option value="gemini-1.5-flash">gemini-1.5-flash (Gemini)</option>
                        <option value="llama3">llama3 (Ollama)</option>
                        <option value="mock-gpt-4o">mock-gpt-4o (MockAI)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary">Temperatura: @temperature</label>
                    <input type="range" class="form-range" min="0.0" max="1.0" step="0.1" @bind="temperature" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary">Tokens Máximos</label>
                    <input type="number" class="form-control bg-black text-white border-secondary" @bind="maxTokens" />
                </div>

                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="streamingSwitch" @bind="enableStreaming" />
                    <label class="form-check-label text-secondary" for="streamingSwitch">Habilitar Streaming (IAsyncEnumerable / SSE)</label>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="failoverSwitch" @bind="enableFailover" />
                    <label class="form-check-label text-secondary" for="failoverSwitch">Habilitar Failover Automático por Salud / Latencia</label>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card bg-dark border-secondary p-4 text-white">
                <h5 class="fw-bold mb-3">Prueba de Generación & Observabilidad</h5>

                <div class="mb-3">
                    <label class="form-label text-secondary">Prompt de Prueba</label>
                    <input type="text" class="form-control bg-black text-white border-secondary" @bind="testPrompt" placeholder="Ej. Genera un resumen ejecutivo de las ventas." />
                </div>

                <button class="btn btn-primary mb-3 fw-bold" @onclick="ExecuteTest">
                    Ejecutar Solicitud en Tiempo Real
                </button>

                @if (isExecuting)
                {
                    <div class="spinner-border spinner-border-sm text-primary mb-3" role="status"></div>
                }

                @if (!string.IsNullOrEmpty(testResult))
                {
                    <div class="bg-black p-3 rounded border border-secondary mb-3">
                        <pre class="text-success mb-0"><code>@testResult</code></pre>
                    </div>

                    <div class="row text-center text-secondary small">
                        <div class="col-4">Tokens Usados: <strong>@tokensUsed</strong></div>
                        <div class="col-4">Latencia: <strong>@latencyMs ms</strong></div>
                        <div class="col-4">Costo Est.: <strong>$@estimatedCostUsd USD</strong></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string activeProvider = "OpenAI";
    private string selectedModel = "gpt-4o";
    private double temperature = 0.7;
    private int maxTokens = 2048;
    private bool enableStreaming = true;
    private bool enableFailover = true;
    private string testPrompt = "Explica los beneficios de la arquitectura hexagonal en .NET 10.";
    private string testResult = string.Empty;
    private bool isExecuting = false;
    private int tokensUsed = 85;
    private double latencyMs = 12.5;
    private double estimatedCostUsd = 0.00017;

    private void SelectProvider(string provider)
    {
        activeProvider = provider;
    }

    private async Task ExecuteTest()
    {
        isExecuting = true;
        testResult = string.Empty;
        await Task.Delay(200);

        testResult = $"[{activeProvider} - {selectedModel}]: Respuesta generada exitosamente en tiempo real para el prompt '{testPrompt}'.";
        isExecuting = false;
    }
}
