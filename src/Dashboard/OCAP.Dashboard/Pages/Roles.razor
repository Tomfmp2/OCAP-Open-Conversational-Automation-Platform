@page "/roles"

<PageTitle>Gestión de Roles (RBAC) — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <h1 class="h3 fw-bold mb-3">Roles y Permisos RBAC</h1>
    <div class="card bg-dark border-secondary p-4">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Rol</th>
                    <th>Descripción</th>
                    <th>Cantidad Permisos</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong class="text-primary">Admin</strong></td>
                    <td>Administrador total del tenant</td>
                    <td>13 permisos</td>
                </tr>
                <tr>
                    <td><strong class="text-info">Operator</strong></td>
                    <td>Operador conversacional y de agentes</td>
                    <td>4 permisos</td>
                </tr>
                <tr>
                    <td><strong class="text-secondary">Viewer</strong></td>
                    <td>Lector de métricas y conversaciones</td>
                    <td>2 permisos</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
