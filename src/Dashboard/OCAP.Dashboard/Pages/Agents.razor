@page "/agents"
@using OCAP.Dashboard.Services
@using OCAP.Dashboard.Models
@using OCAP.Dashboard.Components
@inject IDashboardApiService ApiService

<div class="mb-4">
    <h2 class="fw-bold text-white mb-1">Gestión de Agentes Inteligentes</h2>
    <p class="text-muted">Catálogo y configuración de asistentes virtuales registrados.</p>
</div>

<div class="row g-4">
    @if (agents != null && agents.Any())
    {
        @foreach (var agent in agents)
        {
            <div class="col-md-6">
                <AgentCard Agent="agent" />
            </div>
        }
    }
    else
    {
        <p class="text-muted">Cargando agentes...</p>
    }
</div>

@code {
    private List<AgentModel>? agents;

    protected override async Task OnInitializedAsync()
    {
        agents = await ApiService.GetAgentsAsync();
    }
}
