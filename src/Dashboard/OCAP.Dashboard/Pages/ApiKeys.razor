@page "/api-keys"

<PageTitle>Gestión de API Keys — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <h1 class="h3 fw-bold mb-3">Claves de API (X-API-Key)</h1>
    <div class="card bg-dark border-secondary p-4">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Prefijo</th>
                    <th>Expiración</th>
                    <th>Último Uso</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Integración WhatsApp Evolution</td>
                    <td><code>ocap_live_</code></td>
                    <td>2027-07-27 UTC</td>
                    <td>Hace 10 min</td>
                    <td><span class="badge bg-success">Válida</span></td>
                </tr>
                <tr>
                    <td>Servicio Zapier Webhook</td>
                    <td><code>ocap_live_</code></td>
                    <td>2027-01-27 UTC</td>
                    <td>Ayer</td>
                    <td><span class="badge bg-success">Válida</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
