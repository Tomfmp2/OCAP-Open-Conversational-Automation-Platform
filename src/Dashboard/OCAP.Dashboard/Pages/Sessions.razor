@page "/sessions"

<PageTitle>Sesiones de Usuario — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <h1 class="h3 fw-bold mb-3">Sesiones Activas y Bitácora de Accesos</h1>
    <div class="card bg-dark border-secondary p-4">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Dirección IP</th>
                    <th>User Agent</th>
                    <th>Fecha Inicio</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>192.168.1.50</td>
                    <td>Mozilla/5.0 (X11; Linux x86_64) Chrome/126.0.0.0</td>
                    <td>Hace 45 min</td>
                    <td><span class="badge bg-success">Sesión Activa</span></td>
                </tr>
                <tr>
                    <td>10.0.0.12</td>
                    <td>Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X)</td>
                    <td>Hace 5 horas</td>
                    <td><span class="badge bg-secondary">Cerrada</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
