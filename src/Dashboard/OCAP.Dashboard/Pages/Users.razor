@page "/users"

<PageTitle>Gestión de Usuarios — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <h1 class="h3 fw-bold mb-3">Usuarios del Tenant</h1>
    <div class="card bg-dark border-secondary p-4">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th>Fecha Registro</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Administrador Principal</td>
                    <td>admin@ocap.io</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td>2026-06-01 UTC</td>
                </tr>
                <tr>
                    <td>Operador Conversacional</td>
                    <td>operator@ocap.io</td>
                    <td><span class="badge bg-success">Activo</span></td>
                    <td>2026-07-15 UTC</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
