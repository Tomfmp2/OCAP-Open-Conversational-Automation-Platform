@page "/profile"

<PageTitle>Mi Perfil — OCAP</PageTitle>

<div class="container-fluid py-4 text-white">
    <h1 class="h3 fw-bold mb-3">Perfil de Usuario</h1>
    <div class="card bg-dark border-secondary p-4 col-md-6">
        <div class="mb-3">
            <span class="text-secondary">Nombre:</span>
            <h5 class="fw-bold">Administrador Principal</h5>
        </div>
        <div class="mb-3">
            <span class="text-secondary">Correo Electrónico:</span>
            <h5>admin@ocap.io</h5>
        </div>
        <div class="mb-3">
            <span class="text-secondary">Tenant Activo:</span>
            <h5 class="text-info">Organización Principal (org-principal)</h5>
        </div>
        <div>
            <span class="text-secondary">Rol:</span>
            <span class="badge bg-primary">Admin</span>
        </div>
    </div>
</div>
