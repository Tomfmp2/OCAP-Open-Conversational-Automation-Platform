{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OCAP.Api": "Information",
      "OCAP.Application": "Information",
      "OCAP.Infrastructure": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Authentication": {
    "AutoProvisionUsers": true,
    "ExternalProviders": {
      "Google": {
        "IsEnabled": true,
        "DisplayName": "Google",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      },
      "Microsoft": {
        "IsEnabled": true,
        "DisplayName": "Microsoft",
        "ClientId": "",
        "ClientSecret": "",
        "TenantId": "common",
        "Scope": "openid profile email User.Read"
      },
      "GitHub": {
        "IsEnabled": true,
        "DisplayName": "GitHub",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "read:user user:email"
      },
      "GenericOidc": {
        "IsEnabled": false,
        "DisplayName": "Enterprise SSO",
        "Authority": "https://sso.enterprise.com",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      }
    }
  }
}
