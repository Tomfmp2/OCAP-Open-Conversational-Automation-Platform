{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OCAP.Api": "Information",
      "OCAP.Application": "Information",
      "OCAP.Infrastructure": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "OCAP",
    "Audience": "OCAP.Clients",
    "AccessTokenExpiryMinutes": 60
  },
  "Security": {
    "Vault": {
      "MasterKey": ""
    }
  },
  "Knowledge": {
    "UseInMemory": false,
    "VectorStore": "PgVector",
    "EmbeddingDimensions": 1536,
    "DefaultEmbeddingProvider": "OpenAI",
    "DefaultEmbeddingModel": "text-embedding-3-small"
  },
  "EventBus": {
    "Provider": "InMemory",
    "ConnectionString": "amqp://guest:guest@localhost:5672/",
    "NatsUrl": "nats://localhost:4222",
    "EnableOutbox": true,
    "ImmediateDispatch": true,
    "EnableInbox": true,
    "MaxRetries": 5,
    "OutboxBatchSize": 50
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "./storage"
  },
  "Google": {
    "AccessToken": "",
    "UseInMemory": false,
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": ""
  },
  "OpenTelemetry": {
    "ServiceName": "OCAP.Api",
    "OtlpEndpoint": ""
  },
  "AiProviders": {
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "ModelName": "gpt-4o"
    },
    "Gemini": {
      "ApiKey": "",
      "ModelName": "gemini-1.5-flash"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ModelName": "llama3"
    },
    "Claude": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com/v1",
      "ModelName": "claude-3-5-sonnet-latest"
    }
  },
  "Authentication": {
    "AutoProvisionUsers": true,
    "ExternalProviders": {
      "Google": {
        "IsEnabled": true,
        "DisplayName": "Google",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      },
      "Microsoft": {
        "IsEnabled": true,
        "DisplayName": "Microsoft",
        "ClientId": "",
        "ClientSecret": "",
        "TenantId": "common",
        "Scope": "openid profile email User.Read"
      },
      "GitHub": {
        "IsEnabled": true,
        "DisplayName": "GitHub",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "read:user user:email"
      },
      "GenericOidc": {
        "IsEnabled": false,
        "DisplayName": "Enterprise SSO",
        "Authority": "https://sso.enterprise.com",
        "ClientId": "",
        "ClientSecret": "",
        "Scope": "openid profile email"
      }
    }
  }
}
