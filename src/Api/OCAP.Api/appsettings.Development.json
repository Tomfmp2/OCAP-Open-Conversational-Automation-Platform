{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "OCAP.Api": "Debug",
      "OCAP.Application": "Debug",
      "OCAP.Infrastructure": "Information"
    }
  },
  "UseInMemory": true,
  "InMemoryDbName": "OCAP_Local_NoDocker",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ocap_dev;Username=ocap;Password=ocap_dev_password"
  },
  "EventBus": {
    "Provider": "InMemory"
  },
  "AiProviders": {
    "EnableMock": false,
    "PreferredProvider": "Gemini",
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "ModelName": "gpt-4o-mini"
    },
    "Gemini": {
      "ApiKey": "",
      "ModelName": "gemini-3.5-flash"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "ModelName": "llama3"
    },
    "Claude": {
      "ApiKey": "",
      "BaseUrl": "https://api.anthropic.com/v1",
      "ModelName": "claude-3-5-sonnet-latest"
    }
  },
  "WhatsApp": {
    "Enabled": true,
    "Provider": "Evolution",
    "BaseUrl": "http://localhost:8080",
    "Instance": "ocap-main",
    "ApiKey": "ocap_evolution_secret_key",
    "WebhookUrl": "http://host.docker.internal:5229/api/webhooks/whatsapp"
  },
  "RateLimiting": {
    "EnableRateLimiting": false,
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "QueueLimit": 50
