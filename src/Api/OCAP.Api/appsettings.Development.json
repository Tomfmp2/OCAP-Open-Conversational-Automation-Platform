{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "OCAP.Api": "Debug",
      "OCAP.Application": "Debug",
      "OCAP.Infrastructure": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ocap_dev;Username=ocap;Password=ocap_dev_password"
  },
  "RateLimiting": {
    "EnableRateLimiting": false,
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "QueueLimit": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ],
    "AllowCredentials": false
  },
  "Jwt": {
    "SecretKey": "OCAP_DEV_ONLY_JWT_SECRET_KEY_32CHARS_MIN_LOCAL",
    "Issuer": "OCAP",
    "Audience": "OCAP.Clients",
    "AccessTokenExpiryMinutes": 60
  },
  "Security": {
    "Vault": {
      "MasterKey": "OCAP_DEV_ONLY_VAULT_MASTER_KEY_32CHARS_MIN"
    }
  }
}
