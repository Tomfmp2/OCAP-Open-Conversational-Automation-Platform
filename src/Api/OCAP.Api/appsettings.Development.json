    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "DefaultModel": "nomic-embed-text"
    }
  },
  "Google": {
    "UseInMemory": true
  },
  "Bootstrap": {
    "Enabled": true,
    "AdminEmail": "admin@ocap.io",
    "AdminPassword": "ChangeMe_Admin_2026!",
    "TenantName": "OCAP Local",
    "TenantSlug": "local"
  },
  "Installation": {
    "Completed": false,
    "Target": "Dev",
    "ApiHostPort": 5229,
    "FrontendHostPort": 3000,
    "ConfigPath": "config"
