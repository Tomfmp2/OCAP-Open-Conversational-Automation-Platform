  "Jwt": {
    "SecretKey": "OCAP_DEV_ONLY_JWT_SECRET_KEY_32CHARS_MIN_LOCAL",
    "Issuer": "OCAP",
    "Audience": "OCAP.Clients",
    "AccessTokenExpiryMinutes": 60
  },
  "Security": {
    "Vault": {
      "MasterKey": "OCAP_DEV_ONLY_VAULT_MASTER_KEY_32CHARS_MIN"
    }
  },
  "Knowledge": {
    "UseInMemory": true,
    "VectorStore": "InMemory",
    "EmbeddingDimensions": 1536,
