{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "OCAP.Api": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemory": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ocap_test;Username=ocap;Password=ocap_test_password"
  },
  "RateLimiting": {
    "EnableRateLimiting": false,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "SecretKey": "OCAP_TESTING_JWT_SECRET_KEY_32CHARS_MINIMUM!",
    "Issuer": "OCAP",
    "Audience": "OCAP.Clients",
    "AccessTokenExpiryMinutes": 60
  },
  "Security": {
    "Vault": {
      "MasterKey": "OCAP_TESTING_VAULT_MASTER_KEY_32CHARS_MIN!"
    }
  }
}
