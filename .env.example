# OCAP · variables de entorno
# Lo normal es no editarlo a mano: `ocap install` (o `ocap config`) pregunta lo necesario y lo escribe, y
# scripts/ocap-setup.sh rellena con valores aleatorios los secretos que estén vacíos.

# --- Preferencias (ocap install / ocap config) --------------------------------
# Idioma del instalador, del comando ocap y de las respuestas del asistente del panel: es | en
OCAP_LANGUAGE=es
# 127.0.0.1 = solo este equipo; 0.0.0.0 = también otros dispositivos de tu red (celular, otra PC)
OCAP_BIND_ADDRESS=127.0.0.1
# Abrir el navegador al ejecutar `ocap`: true | false
OCAP_OPEN_BROWSER=true

# --- Puertos publicados en tu equipo (ocap install elige libres si hay choques) -
FRONTEND_HOST_PORT=3000
API_HOST_PORT=5000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
JAEGER_HOST_PORT=16686
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
NGINX_HOST_PORT=80
EVOLUTION_HOST_PORT=8088
PUBLIC_PANEL_URL=http://localhost:3000

# --- Administrador inicial (ocap install) ---------------------------------------
# Se usan una sola vez para crear la cuenta; tras el primer arranque `ocap` borra la contraseña de aquí.
# Vacíos: la cuenta se crea en el panel (/setup) con el código que muestra `ocap`.
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Entorno -------------------------------------------------------------------
# Entorno de la API en Docker. Development solo para depurar: expone Swagger y el detalle de los errores.
OCAP_API_ENVIRONMENT=Production
EVENTBUS_PROVIDER=RabbitMQ
STORAGE_PROVIDER=Local

# --- Base de datos y mensajería ------------------------------------------------
POSTGRES_DB=ocap_db
# Dueño de la base: solo lo usa ocap-migrate. La API se conecta con OCAP_DB_APP_USER (sin superusuario ni BYPASSRLS).
POSTGRES_USER=ocap_user
OCAP_DB_APP_USER=ocap_app
RABBITMQ_USER=ocap

# --- Secretos: los genera ocap-setup.sh si están vacíos. No los compartas. ------
POSTGRES_PASSWORD=
OCAP_DB_APP_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET_KEY=
VAULT_MASTER_KEY=
EVOLUTION_API_KEY=

# --- Correo (opcional) ---------------------------------------------------------------
# Para enviar invitaciones del equipo y "olvidé mi contraseña" por email. Sin él, los enlaces se copian desde
# Ajustes → Equipo y el administrador los comparte a mano.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# --- IA (opcional) ---------------------------------------------------------------
# Se puede configurar después en el panel (IA y modelos). Sin ninguna clave, OCAP arranca en modo demo:
# el asistente responde con un proveedor simulado. AiProviders__DemoMode=false lo desactiva (p. ej. solo Ollama).
AiProviders__Gemini__ApiKey=
AiProviders__Gemini__ModelName=gemini-3.5-flash
AiProviders__OpenAI__ApiKey=
AiProviders__OpenAI__ModelName=gpt-4o
AiProviders__Claude__ApiKey=

# --- Integraciones (opcional) ------------------------------------------------------
Google__ClientId=
Google__ClientSecret=
Google__RedirectUri=http://localhost:5000/api/integrations/Google/connect
# Telegram: el bot se conecta desde el panel (Canales → Conectar canal → Telegram) con su token; no va aquí.

