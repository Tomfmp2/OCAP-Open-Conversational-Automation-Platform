#!/usr/bin/env bash
# OCAP: instalar y levantar todo (base de datos, API, panel, WhatsApp) con Docker desde cualquier terminal.
#
#   ./ocap install     (una vez, desde la carpeta del repo) configura, instala lo que falte y el comando `ocap`
#   ocap               levanta OCAP (enciende Docker si hace falta) y abre el panel
#   ocap help          todos los comandos
set -euo pipefail

# Carpeta real del repo, aunque se llame a través del enlace de ~/.local/bin.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
ROOT="$(cd -P "$(dirname "$src")" && pwd)"
cd "$ROOT"

ENV_FILE="$ROOT/.env"
BIN_DIR="${OCAP_BIN_DIR:-$HOME/.local/bin}"
STATE_DIR="$ROOT/.ocap"
BUILD_STAMP="$STATE_DIR/build-stamp"
CONFIGURED_MARK="$STATE_DIR/configured"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '==> %s\n' "$*"; }
fail() { printf '\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }

# shellcheck source=scripts/lib/i18n.sh
source "$ROOT/scripts/lib/i18n.sh"
# shellcheck source=scripts/lib/envfile.sh
source "$ROOT/scripts/lib/envfile.sh"
# shellcheck source=scripts/lib/prereqs.sh
source "$ROOT/scripts/lib/prereqs.sh"
# shellcheck source=scripts/lib/autostart.sh
source "$ROOT/scripts/lib/autostart.sh"
# shellcheck source=scripts/lib/wizard.sh
source "$ROOT/scripts/lib/wizard.sh"

# Idioma elegido en la instalación (OCAP_LANG lo fuerza para una ejecución).
OCAP_LANGUAGE="${OCAP_LANG:-$(env_get "$ENV_FILE" OCAP_LANGUAGE)}"
OCAP_LANGUAGE="${OCAP_LANGUAGE:-es}"
export OCAP_LANGUAGE

# HTTPS público: con OCAP_DOMAIN en el .env se levanta Caddy (perfil https) con certificado de Let's Encrypt.
OCAP_DOMAIN_VALUE="$(env_get "$ENV_FILE" OCAP_DOMAIN)"
if [[ -n "$OCAP_DOMAIN_VALUE" ]]; then
  export COMPOSE_PROFILES="https${COMPOSE_PROFILES:+,$COMPOSE_PROFILES}"
fi

# El panel y la API deben conocer la URL pública (CORS, enlaces de invitación); el certificado necesita un correo.
prepare_https() {
  [[ -n "$OCAP_DOMAIN_VALUE" ]] || return 0
  [[ -n "$(env_get "$ENV_FILE" OCAP_ACME_EMAIL)" ]] || fail "$(t https_needs_email)"
  env_set "$ENV_FILE" PUBLIC_PANEL_URL "https://${OCAP_DOMAIN_VALUE}"
}

panel_port() { local p; p="$(env_get "$ENV_FILE" FRONTEND_HOST_PORT)"; echo "${p:-3000}"; }
api_port() { local p; p="$(env_get "$ENV_FILE" API_HOST_PORT)"; echo "${p:-5000}"; }

# --- Docker -------------------------------------------------------------------------------------
# Para levantar: si falta algo, se indica `ocap install`, que es quien instala dependencias.
require_tools() {
  local missing
  missing="$(missing_prerequisites)"
  [[ -z "$missing" ]] || fail "$(t missing_run_install "$missing")"
}

# Enciende Docker si está apagado y corrige el permiso del usuario si hace falta; espera a que responda.
ensure_docker() {
  dk info >/dev/null 2>&1 && return 0

  if docker info 2>&1 | grep -qi "permission denied"; then
    info "$(t docker_permission)"
    confirm "$(t docker_group_ask)" || fail "sudo usermod -aG docker \$USER"
    grant_docker_group
    dk info >/dev/null 2>&1 && return 0
  fi

  info "$(t docker_off)"
  if [[ "$(uname -s)" == "Darwin" ]]; then
    if command -v colima >/dev/null 2>&1; then
      colima start --cpu 4 --memory 8 >/dev/null
    else
      open -a Docker >/dev/null 2>&1 || true
    fi
  elif systemctl --user cat docker-desktop.service >/dev/null 2>&1 && docker context show 2>/dev/null | grep -q desktop; then
    systemctl --user start docker-desktop || true
  elif command -v systemctl >/dev/null 2>&1 && systemctl cat docker.service >/dev/null 2>&1; then
    as_root systemctl start docker
  else
    fail "$(t docker_no_response)"
  fi

  for _ in $(seq 1 90); do
    dk info >/dev/null 2>&1 && { info "$(t docker_ready)"; return 0; }
    sleep 2
  done
  fail "$(t docker_timeout)"
}

stack_running() { [[ -n "$(dk compose ps -q 2>/dev/null)" ]]; }

# Antes de levantar: un puerto tomado por otro programa haría fallar a Docker con un error poco claro.
check_ports() {
  stack_running && return 0
  local entry key default label port
  for entry in $OCAP_PORTS; do
    key="${entry%%:*}"; default="${entry#*:}"; label="${default#*:}"; default="${default%%:*}"
    port="$(env_get "$ENV_FILE" "$key")"
    port="${port:-$default}"
    port_in_use "$port" && fail "$(t port_busy "$port" "$label")"
  done
  return 0
}

# --- Construcción ---------------------------------------------------------------------------------
# Huella del código que va en las imágenes: commit actual + cambios sin commitear en lo que se construye.
code_fingerprint() {
  if git -C "$ROOT" rev-parse HEAD >/dev/null 2>&1; then
    {
      git -C "$ROOT" rev-parse HEAD
      git -C "$ROOT" status --porcelain -- src frontend docker docker-compose.yml 2>/dev/null
      git -C "$ROOT" diff -- src frontend docker docker-compose.yml 2>/dev/null
    } | cksum | cut -d' ' -f1
  else
    echo "sin-git"
  fi
}

needs_build() {
  [[ ! -f "$BUILD_STAMP" ]] || [[ "$(cat "$BUILD_STAMP")" != "$(code_fingerprint)" ]]
}

build() {
  info "$(t building)"
  dk compose build
  mkdir -p "$STATE_DIR"
  code_fingerprint > "$BUILD_STAMP"
}

# --- Comandos ---------------------------------------------------------------------------------------
wait_for() {
  local name="$1" url="$2"
  printf '==> %s' "$(t waiting "$name")"
  for _ in $(seq 1 72); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      echo "OK"
      return 0
    fi
    printf '.'
    sleep 5
  done
  echo
  fail "$(t not_responding "$name")"
}

open_browser() {
  [[ "${OCAP_NO_BROWSER:-}" == "1" || ! -t 1 ]] && return 0
  [[ "$(env_get "$ENV_FILE" OCAP_OPEN_BROWSER)" == "false" ]] && return 0
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$1" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$1" >/dev/null 2>&1 &
  fi
}

# La contraseña del admin solo hace falta para crearlo: en cuanto existe, se quita del .env.
forget_admin_password() {
  [[ -n "$(env_get "$ENV_FILE" BOOTSTRAP_ADMIN_PASSWORD)" ]] || return 0
  env_set "$ENV_FILE" BOOTSTRAP_ADMIN_PASSWORD ""
  t admin_ready "$(env_get "$ENV_FILE" BOOTSTRAP_ADMIN_EMAIL)"; echo
  t password_removed; echo
}

cmd_start() {
  local force_build=0
  [[ "${1:-}" == "--build" ]] && force_build=1

  require_tools
  ensure_docker
  "$ROOT/scripts/ocap-setup.sh" >/dev/null
  prepare_https
  check_ports
  if (( force_build )) || needs_build; then
    build
  fi

  info "$(t starting)"
  dk compose up -d --remove-orphans

  local panel api
  panel="$(panel_port)"
  api="$(api_port)"
  wait_for "$(t the_api)" "http://127.0.0.1:${api}/health/ready"
  wait_for "$(t the_panel)" "http://127.0.0.1:${panel}/login"

  echo
  bold "  $(t running)"
  echo "  Panel: http://localhost:${panel}"
  echo "  API:   http://localhost:${api}"
  [[ -n "$OCAP_DOMAIN_VALUE" ]] && echo "  HTTPS: https://${OCAP_DOMAIN_VALUE}"
  if [[ "$(env_get "$ENV_FILE" OCAP_BIND_ADDRESS)" == "0.0.0.0" ]]; then
    local ip
    ip="$(lan_ip)"
    [[ -n "$ip" ]] && echo "  $(t lan_url "http://${ip}:${panel}")"
  fi

  local target="http://localhost:${panel}"
  echo
  if curl -fsS "http://127.0.0.1:${api}/api/setup/status" 2>/dev/null | grep -q '"required":true'; then
    # El código solo se imprime en los logs de la API: quien levanta el servidor es quien configura.
    local code
    code="$(dk compose logs ocap-api 2>/dev/null | grep -oE '[A-Z2-9]{4}-[A-Z2-9]{4}-[A-Z2-9]{4}' | tail -n1 || true)"
    target="${target}/setup"
    bold "  $(t first_setup "$target")"
    [[ -n "$code" ]] && echo "  $(t setup_code "$code")"
  else
    forget_admin_password
  fi
  echo
  echo "  $(t hints)"
  open_browser "$target"
}

cmd_stop() {
  require_tools
  dk info >/dev/null 2>&1 || { info "$(t already_stopped)"; return 0; }
  info "$(t stopping)"
  dk compose stop
}

cmd_status() {
  require_tools
  if ! dk info >/dev/null 2>&1; then
    t status_docker_off; echo
    return 0
  fi
  dk compose ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  local panel api
  panel="$(panel_port)"
  api="$(api_port)"
  if curl -fsS "http://127.0.0.1:${api}/health/ready" >/dev/null 2>&1; then echo "API:   $(t status_ok) (http://localhost:${api})"; else echo "API:   $(t status_down)"; fi
  if curl -fsS "http://127.0.0.1:${panel}/login" >/dev/null 2>&1; then echo "Panel: $(t status_ok) (http://localhost:${panel})"; else echo "Panel: $(t status_down)"; fi
  if autostart_is_enabled; then t autostart_status_on; else t autostart_status_off; fi
  echo
}

cmd_logs() {
  require_tools
  ensure_docker
  dk compose logs -f --tail 100 "$@"
}

cmd_update() {
  require_tools
  info "$(t updating)"
  git -C "$ROOT" pull --ff-only
  cmd_start --build
}

cmd_reset() {
  require_tools
  ensure_docker
  t reset_warning; echo
  local answer
  answer="$(_ask "$(t reset_confirm)")"
  [[ "$answer" == "$(t reset_word)" ]] || { t cancelled; echo; return 0; }
  dk compose down -v --remove-orphans
  cmd_start
}

# --- Copias de seguridad ------------------------------------------------------------------------
BACKUP_DIR="$ROOT/backups"

# Espera a que Postgres acepte conexiones (lo levanta si estaba apagado).
ensure_postgres() {
  dk compose up -d postgres >/dev/null
  for _ in $(seq 1 30); do
    # shellcheck disable=SC2016 # las variables se expanden dentro del contenedor de Postgres
    dk compose exec -T postgres sh -c 'pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"' >/dev/null 2>&1 && return 0
    sleep 2
  done
  fail "$(t not_responding PostgreSQL)"
}

# Base (pg_dump) y archivos subidos en un solo .tar con permisos 600. El .env no entra: tiene las claves maestras.
cmd_backup() {
  require_tools
  ensure_docker
  ensure_postgres

  local work file
  umask 077
  mkdir -p "$BACKUP_DIR"
  work="$(mktemp -d "$BACKUP_DIR/.tmp.XXXXXX")"
  trap 'rm -rf "$work"' RETURN
  file="$BACKUP_DIR/ocap-$(date +%Y%m%d-%H%M%S).tar"

  info "$(t backup_database)"
  # shellcheck disable=SC2016 # las variables se expanden dentro del contenedor de Postgres
  dk compose exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$work/database.dump"
  info "$(t backup_files)"
  dk compose run --rm --no-deps -T storage-permissions tar -cf - -C /app/storage . > "$work/storage.tar"

  tar -C "$work" -cf "$file" database.dump storage.tar
  chmod 600 "$file"
  bold "$(t backup_done "$file")"
  t backup_env_warning; echo
}

cmd_restore() {
  local file="${1:-}"
  [[ -n "$file" && -f "$file" ]] || fail "$(t restore_usage)"
  require_tools
  ensure_docker

  t restore_warning; echo
  local answer
  answer="$(_ask "$(t reset_confirm)")"
  [[ "$answer" == "$(t reset_word)" ]] || { t cancelled; echo; return 0; }

  local work
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' RETURN
  tar -C "$work" -xf "$file" database.dump storage.tar || fail "$(t restore_invalid)"

  info "$(t stopping)"
  dk compose stop ocap-api ocap-frontend >/dev/null 2>&1 || true
  ensure_postgres
  info "$(t backup_database)"
  # shellcheck disable=SC2016 # las variables se expanden dentro del contenedor de Postgres
  dk compose exec -T postgres sh -c 'pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --clean --if-exists --no-owner' \
    < "$work/database.dump"
  info "$(t backup_files)"
  dk compose run --rm --no-deps -T storage-permissions \
    sh -c 'rm -rf /app/storage/* && tar -xf - -C /app/storage && chown -R 1654:1654 /app/storage' < "$work/storage.tar"

  # Al arrancar, ocap-migrate aplica migraciones pendientes, RLS y los permisos del rol de la API.
  cmd_start
}

link_command() {
  mkdir -p "$BIN_DIR"
  ln -sfn "$ROOT/ocap" "$BIN_DIR/ocap"
  info "$(t command_installed "$BIN_DIR/ocap")"

  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
      echo
      echo "  $(t path_hint "$BIN_DIR")"
      case "$(basename "${SHELL:-bash}")" in
        fish) echo "    fish_add_path $BIN_DIR" ;;
        zsh) echo "    echo 'export PATH=\"$BIN_DIR:\$PATH\"' >> ~/.zshrc" ;;
        *) echo "    echo 'export PATH=\"$BIN_DIR:\$PATH\"' >> ~/.bashrc" ;;
      esac
      ;;
  esac
}

apply_autostart() {
  if [[ "$W_AUTOSTART" == "1" ]]; then autostart_enable
  elif autostart_is_enabled; then autostart_disable
  fi
}

cmd_install() {
  local first_time=1 wizard_mode=install
  [[ -f "$CONFIGURED_MARK" ]] && first_time=0
  # Instalación previa al asistente: ya tiene .env (y su cuenta), así que solo se preguntan las preferencias.
  [[ -f "$ENV_FILE" ]] && wizard_mode=config

  # El idioma primero: todo lo demás ya se pregunta y se informa en ese idioma.
  if (( first_time )); then
    ask_language
    bold "$(t installing_from "$ROOT")"
    [[ "$wizard_mode" == config ]] && dk info >/dev/null 2>&1 && stack_running && export OCAP_SKIP_PORT_CHECK=1
    wizard_run "$wizard_mode" "$ENV_FILE"
  else
    bold "$(t installing_from "$ROOT")"
    t already_configured; echo
  fi

  ensure_prerequisites
  ensure_docker
  "$ROOT/scripts/ocap-setup.sh" >/dev/null
  if (( first_time )); then
    wizard_apply "$ENV_FILE"
  fi
  build
  link_command
  if (( first_time )); then
    apply_autostart
    mkdir -p "$STATE_DIR"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$CONFIGURED_MARK"
  fi

  echo
  bold "$(t install_done)"
  if interactive && ask_yes_no "$(t start_now)" s; then
    echo
    cmd_start
  fi
}

cmd_config() {
  [[ -f "$ENV_FILE" ]] || "$ROOT/scripts/ocap-setup.sh" >/dev/null
  dk info >/dev/null 2>&1 && stack_running && export OCAP_SKIP_PORT_CHECK=1
  ask_language
  wizard_run config "$ENV_FILE"
  wizard_apply "$ENV_FILE"
  apply_autostart
  t config_saved; echo
  stack_running 2>/dev/null && { t config_restart; echo; }
  return 0
}

cmd_autostart() {
  case "${1:-}" in
    on) autostart_enable ;;
    off) autostart_disable ;;
    *) if autostart_is_enabled; then t autostart_status_on; else t autostart_status_off; fi; echo ;;
  esac
}

cmd_uninstall() {
  autostart_is_enabled && autostart_disable
  if [[ -L "$BIN_DIR/ocap" ]]; then
    rm "$BIN_DIR/ocap"
    info "$(t uninstalled)"
  else
    info "$(t not_installed "$BIN_DIR")"
  fi
}

case "${1:-start}" in
  start) shift || true; cmd_start "$@" ;;
  install) cmd_install ;;
  config) cmd_config ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  logs) shift; cmd_logs "$@" ;;
  autostart) shift; cmd_autostart "$@" ;;
  update) cmd_update ;;
  reset) cmd_reset ;;
  backup) cmd_backup ;;
  restore) shift; cmd_restore "$@" ;;
  uninstall) cmd_uninstall ;;
  -h|--help|help) t help ;;
  *) t unknown_command "$1" >&2; echo >&2; t help; exit 2 ;;
esac
